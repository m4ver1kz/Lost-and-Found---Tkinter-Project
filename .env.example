# ============================================================================
# Lost and Found Management System - Environment Configuration Template
# ============================================================================
# Copy this file to '.env' or configure these environment variables in your system.
# Never commit your actual passwords or production secrets to Git.
# ============================================================================

# MySQL Database Host and Port
DB_HOST=localhost
DB_PORT=3306

# Database Name (Created using database/lost_and_found.sql)
DB_NAME=lost_and_found

# MySQL Database Credentials (Placeholder values only)
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Java Spring Boot Server Port
SERVER_PORT=8080

# Python Frontend API Base Endpoint
API_BASE_URL=http://localhost:8080/api
